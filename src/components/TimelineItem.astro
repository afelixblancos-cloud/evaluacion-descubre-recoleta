---
interface Props {
  year: string;
  title: string;
  description: string;
}

const { year, title, description } = Astro.props;
---
<div class="timeline-item">
  <div class="timeline-marker">{year}</div>
  <div class="timeline-content">
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</div>

<style>
  .timeline-item {
    display: flex;
    gap: 1.5rem;
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: 40px;
    top: 40px;
    bottom: 0;
    width: 2px;
    background-color: var(--border);
  }

  .timeline-item:last-child::before {
    display: none;
  }

  .timeline-marker {
    background-color: var(--primary);
    color: white;
    font-weight: 700;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    height: fit-content;
    white-space: nowrap;
    z-index: 1;
  }

  .timeline-content {
    background-color: var(--surface);
    border: 1px solid var(--border);
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    flex: 1;
  }
</style>